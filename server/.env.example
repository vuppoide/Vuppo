PORT=4000
NODE_ENV=development
DATA_DIR=./data

# OpenRouter (chave mantida somente no backend - nunca no frontend)
OPENROUTER_API_KEY=sua-chave-openrouter-aqui
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Failover automático em rate limit (separados por vírgia; deixe vazio para desativar)
OPENROUTER_MODEL_FALLBACKS=nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free
